<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/android:colorBackground"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:contentInsetStart="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Logo mini -->
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_splash_logo"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="EV DOCTOR"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="18sp"
                    android:textColor="?attr/colorOnSurface"
                    android:letterSpacing="0.05"
                    android:layout_marginStart="10dp" />

                <!-- Theme toggle -->
                <ImageButton
                    android:id="@+id/btnThemeToggle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_container_blue"
                    android:src="@drawable/ic_theme_toggle"
                    android:contentDescription="Toggle Theme"
                    android:padding="8dp" />

            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- Gradient divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/bg_divider_gradient" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New Test"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="26sp"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fill in the details to begin your battery analysis"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.5"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- ═══════════════════════════════════════════ -->
            <!-- SECTION 1: Client Information              -->
            <!-- ═══════════════════════════════════════════ -->
            <include layout="@layout/layout_section_header_client" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorSurfaceVariant"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Client Name -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilClientName"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/client_name"
                        app:startIconDrawable="@drawable/ic_person"
                        app:startIconTint="@color/brand_blue"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="@color/input_stroke_selector"
                        app:hintTextColor="@color/brand_blue">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etClientName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName|textCapWords"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="15sp"
                            android:imeOptions="actionNext" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Client ID -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilClientId"
                        android:visibility="gone"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/client_id"
                        android:layout_marginTop="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="@color/input_stroke_selector"
                        app:hintTextColor="@color/brand_blue">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etClientId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_client_id"
                            android:inputType="text"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="15sp"
                            android:imeOptions="actionNext" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Phone + Email Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPhone"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/client_phone"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxStrokeColor="@color/input_stroke_selector"
                            app:hintTextColor="@color/brand_blue">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPhone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="phone"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="14sp"
                                android:imeOptions="actionNext" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilEmail"
                            android:visibility="gone"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/client_email"
                            android:layout_marginStart="6dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxStrokeColor="@color/input_stroke_selector"
                            app:hintTextColor="@color/brand_blue">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/hint_email"
                                android:inputType="textEmailAddress"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="14sp"
                                android:imeOptions="actionNext" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════ -->
            <!-- SECTION 2: Vehicle Information             -->
            <!-- ═══════════════════════════════════════════ -->
            <include layout="@layout/layout_section_header_vehicle"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorSurfaceVariant"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Vehicle Model -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilVehicleModel"
                        android:visibility="gone"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/vehicle_model"
                        app:startIconDrawable="@drawable/ic_car"
                        app:startIconTint="@color/brand_blue"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="@color/input_stroke_selector"
                        app:hintTextColor="@color/brand_blue">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etVehicleModel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_vehicle_model"
                            android:inputType="text|textCapWords"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="15sp"
                            android:imeOptions="actionNext" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Vehicle Number -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilVehicleNumber"
                        android:visibility="gone"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/vehicle_number"
                        android:layout_marginTop="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="@color/input_stroke_selector"
                        app:hintTextColor="@color/brand_blue">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etVehicleNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_vehicle_number"
                            android:inputType="textCapCharacters"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="15sp"
                            android:imeOptions="actionNext" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════ -->
            <!-- SECTION 3: Battery Information             -->
            <!-- ═══════════════════════════════════════════ -->
            <include layout="@layout/layout_section_header_battery" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorSurfaceVariant"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Battery Make Dropdown -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilBatteryMake"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Battery Chemistry Type"
                        app:startIconDrawable="@drawable/ic_battery"
                        app:startIconTint="@color/status_good"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="@color/input_stroke_selector"
                        app:hintTextColor="@color/brand_blue">

                        <AutoCompleteTextView
                            android:id="@+id/actvBatteryMake"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Battery Model -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilBatteryModel"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Battery Serial Number"
                        android:layout_marginTop="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="@color/input_stroke_selector"
                        app:hintTextColor="@color/brand_blue">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBatteryModel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="15sp"
                            android:imeOptions="actionNext" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Chemistry Dropdown -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilChemistry"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Battery Voltage (V)"
                        android:layout_marginTop="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="@color/input_stroke_selector"
                        app:hintTextColor="@color/brand_blue">

                        <AutoCompleteTextView
                            android:id="@+id/actvChemistry"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Capacity + Voltage Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilCapacity"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Battery Chemistry"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxStrokeColor="@color/input_stroke_selector"
                            app:hintTextColor="@color/brand_blue">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCapacity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="15sp"
                                android:imeOptions="actionNext" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilVoltage"
                            android:visibility="gone"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Voltage (V)"
                            android:layout_marginStart="6dp"
                            app:suffixText="V"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxStrokeColor="@color/input_stroke_selector"
                            app:hintTextColor="@color/brand_blue">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etVoltage"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/hint_voltage"
                                android:inputType="numberDecimal"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="15sp"
                                android:imeOptions="actionNext" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <!-- Number of Cells -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCells"
                        android:visibility="gone"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/battery_cells"
                        android:layout_marginTop="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="@color/input_stroke_selector"
                        app:hintTextColor="@color/brand_blue">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCells"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_cells"
                            android:inputType="number"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="15sp"
                            android:imeOptions="actionDone" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════ -->
            <!-- SECTION 4: Test Mode Selection             -->
            <!-- ═══════════════════════════════════════════ -->
            <include layout="@layout/layout_section_header_testmode" />

            <!-- Error text for mode -->
            <TextView
                android:id="@+id/tvModeError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/error_select_mode"
                android:textColor="@color/status_critical"
                android:textSize="12sp"
                android:fontFamily="@font/inter_regular"
                android:layout_marginTop="4dp"
                android:layout_marginStart="4dp"
                android:visibility="gone" />

            <!-- Mode Cards Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="28dp">

                <!-- Flash Mode Card -->
                <LinearLayout
                    android:id="@+id/cardFlashMode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_mode_card_normal"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <!-- Icon + Check row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_mode_icon_flash">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_flash" />

                        </FrameLayout>

                        <ImageView
                            android:id="@+id/ivFlashCheck"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_check_circle"
                            android:visibility="invisible"
                            android:layout_gravity="top" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mode_flash"
                        android:fontFamily="@font/inter_semibold"
                        android:textSize="15sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mode_flash_desc"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="11sp"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.5"
                        android:layout_marginTop="4dp" />

                    <!-- Duration tag -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="~5 min"
                        android:fontFamily="@font/inter_semibold"
                        android:textSize="10sp"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_tag"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:layout_marginTop="10dp" />

                </LinearLayout>

                <!-- Normal Mode Card -->
                <LinearLayout
                    android:id="@+id/cardNormalMode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_mode_card_normal"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_mode_icon_normal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_analytics" />

                        </FrameLayout>

                        <ImageView
                            android:id="@+id/ivNormalCheck"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_check_circle"
                            android:visibility="invisible"
                            android:layout_gravity="top"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mode_normal"
                        android:fontFamily="@font/inter_semibold"
                        android:textSize="15sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mode_normal_desc"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="11sp"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.5"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="~20 min"
                        android:fontFamily="@font/inter_semibold"
                        android:textSize="10sp"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_tag"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:layout_marginTop="10dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- START TEST BUTTON -->
