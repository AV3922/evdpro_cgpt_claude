<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground">

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/android:colorBackground"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:contentInsetStart="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_container_blue"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="Back"
                    android:padding="8dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Test Report"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/tvReportDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.5" />

                </LinearLayout>

                <!-- Share Button -->
                <ImageButton
                    android:id="@+id/btnShare"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_container_blue"
                    android:src="@drawable/ic_share"
                    android:contentDescription="Share"
                    android:padding="8dp"
                    android:layout_marginEnd="8dp" />

                <!-- Download PDF Button -->
                <ImageButton
                    android:id="@+id/btnDownload"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_gradient_primary"
                    android:src="@drawable/ic_download"
                    android:contentDescription="Download PDF"
                    android:padding="8dp" />

            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/bg_divider_gradient" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Report Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/reportScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingTop="16dp"
            android:paddingBottom="40dp">

            <!-- ═════════════════════════════════════════ -->
            <!-- OVERALL HEALTH SCORE - Hero Card         -->
            <!-- ═════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_gradient_primary"
                    android:padding="24dp">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="20dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_report"
                            android:tint="@color/white"
                            android:alpha="0.8" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Battery Health Analysis"
                            android:fontFamily="@font/inter_semibold"
                            android:textSize="14sp"
                            android:textColor="#CCCCFF"
                            android:layout_marginStart="8dp" />

                        <!-- Report ID tag -->
                        <TextView
                            android:id="@+id/tvReportId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="#001"
                            android:fontFamily="@font/inter_medium"
                            android:textSize="11sp"
                            android:textColor="#CCCCFF"
                            android:alpha="0.7" />

                    </LinearLayout>

                    <!-- Health Score -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Overall Health Score"
                                android:fontFamily="@font/inter_medium"
                                android:textSize="13sp"
                                android:textColor="#CCCCFF"
                                android:alpha="0.8" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="bottom">

                                <TextView
                                    android:id="@+id/tvHealthScore"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:fontFamily="@font/inter_bold"
                                    android:textSize="60sp"
                                    android:textColor="@color/white"
                                    android:includeFontPadding="false" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="%"
                                    android:fontFamily="@font/inter_semibold"
                                    android:textSize="24sp"
                                    android:textColor="@color/white"
                                    android:alpha="0.7"
                                    android:layout_marginStart="4dp"
                                    android:layout_marginBottom="10dp" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvHealthLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="EXCELLENT"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="13sp"
                                android:textColor="@color/white"
                                android:letterSpacing="0.1"
                                android:alpha="0.9" />

                        </LinearLayout>

                        <!-- Health Ring Visual -->
                        <LinearLayout
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_health_ring">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_battery"
                                android:tint="#FFFFFF" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Health Progress Bar -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/healthProgressBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:progress="0"
                        android:max="100"
                        app:indicatorColor="#FFFFFF"
                        app:trackColor="#33FFFFFF"
                        app:trackCornerRadius="4dp"
                        android:indeterminate="false" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═════════════════════════════════════════ -->
            <!-- TEST SESSION INFO                        -->
            <!-- ═════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorSurfaceVariant"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Section Title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_icon_container_blue">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_person"
                                android:tint="@color/brand_blue" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Test Summary"
                            android:fontFamily="@font/inter_semibold"
                            android:textSize="15sp"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginStart="10dp" />

                    </LinearLayout>

                    <!-- Info Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <include
                            layout="@layout/layout_report_info_item"
                            android:id="@+id/itemClientName"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp" />

                        <include
                            layout="@layout/layout_report_info_item"
                            android:id="@+id/itemClientId"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <include
                            layout="@layout/layout_report_info_item"
                            android:id="@+id/itemVehicle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp" />

                        <include
                            layout="@layout/layout_report_info_item"
                            android:id="@+id/itemTestMode"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include
                            layout="@layout/layout_report_info_item"
                            android:id="@+id/itemDuration"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp" />

                        <include
                            layout="@layout/layout_report_info_item"
                            android:id="@+id/itemDate"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═════════════════════════════════════════ -->
            <!-- SAFETY STATUS                            -->
            <!-- ═════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorSurfaceVariant"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Section Title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_icon_container_green">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_check_circle"
                                android:tint="@color/status_good" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Safety Status"
                            android:fontFamily="@font/inter_semibold"
                            android:textSize="15sp"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginStart="10dp" />

                    </LinearLayout>

                    <!-- Safety Badge -->
                    <LinearLayout
                        android:id="@+id/safetyBadge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="@drawable/bg_status_safe">

                        <ImageView
                            android:id="@+id/ivSafetyIcon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_check_circle"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvSafetyStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SAFE"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="18sp"
                                android:textColor="@color/status_good"
                                android:letterSpacing="0.05" />

                            <TextView
                                android:id="@+id/tvSafetyDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Battery is operating within safe parameters"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="12sp"
                                android:textColor="@color/status_good"
                                android:alpha="0.8"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Safety Parameter Table -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp">

                        <include layout="@layout/layout_safety_row"
                            android:id="@+id/safetyRowVoltage" />

                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="?attr/colorSurfaceVariant" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" />

                        <include layout="@layout/layout_safety_row"
                            android:id="@+id/safetyRowTemp" />

                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="?attr/colorSurfaceVariant" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" />

                        <include layout="@layout/layout_safety_row"
                            android:id="@+id/safetyRowCurrent" />

                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="?attr/colorSurfaceVariant" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" />

                        <include layout="@layout/layout_safety_row"
                            android:id="@+id/safetyRowSoc" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═════════════════════════════════════════ -->
            <!-- BATTERY FAULTS                           -->
            <!-- ═════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorSurfaceVariant"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Section Title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_icon_container_orange">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_warning"
                                android:tint="@color/status_warning" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Battery Faults"
                            android:fontFamily="@font/inter_semibold"
                            android:textSize="15sp"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginStart="10dp" />

                        <TextView
                            android:id="@+id/tvFaultCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="13sp"
                            android:textColor="@color/white"
                            android:background="@drawable/bg_tag"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp" />

                    </LinearLayout>

                    <!-- No Faults Message -->
                    <LinearLayout
                        android:id="@+id/layoutNoFaults"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:visibility="visible">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_check_circle"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No faults detected"
                            android:fontFamily="@font/inter_medium"
                            android:textSize="14sp"
                            android:textColor="@color/status_good" />

                    </LinearLayout>

                    <!-- Faults List -->
                    <LinearLayout
                        android:id="@+id/layoutFaultsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═════════════════════════════════════════ -->
            <!-- ENERGY PARAMETERS                        -->
            <!-- ═════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorSurfaceVariant"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Section Title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_icon_container_blue">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_voltage"
                                android:tint="@color/brand_blue" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Energy Parameters"
                            android:fontFamily="@font/inter_semibold"
                            android:textSize="15sp"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginStart="10dp" />

                    </LinearLayout>

                    <!-- Energy Grid 2x2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <include
                            layout="@layout/layout_param_card"
                            android:id="@+id/paramVoltage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp" />

                        <include
                            layout="@layout/layout_param_card"
                            android:id="@+id/paramCurrent"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include
                            layout="@layout/layout_param_card"
                            android:id="@+id/paramPower"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp" />

                        <include
                            layout="@layout/layout_param_card"
                            android:id="@+id/paramCapacity"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═════════════════════════════════════════ -->
            <!-- HEALTH PARAMETERS                        -->
            <!-- ═════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorSurfaceVariant"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Section Title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_icon_container_green">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_health"
                                android:tint="@color/status_good" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Health Parameters"
                            android:fontFamily="@font/inter_semibold"
                            android:textSize="15sp"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginStart="10dp" />

                    </LinearLayout>

                    <!-- Health Grid 2x2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <include
                            layout="@layout/layout_param_card"
                            android:id="@+id/paramSoc"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp" />

                        <include
                            layout="@layout/layout_param_card"
                            android:id="@+id/paramTemp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include
                            layout="@layout/layout_param_card"
                            android:id="@+id/paramResistance"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp" />

                        <include
                            layout="@layout/layout_param_card"
                            android:id="@+id/paramCycles"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═════════════════════════════════════════ -->
            <!-- AI RECOMMENDATION (bonus section)        -->
            <!-- ═════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_ai_recommendation"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI Recommendation"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="14sp"
                            android:textColor="#EEEEFF"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Beta"
                            android:fontFamily="@font/inter_medium"
                            android:textSize="10sp"
                            android:textColor="#CCCCFF"
                            android:background="@drawable/bg_tag"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:alpha="0.8" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAiRecommendation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Battery is in excellent condition. Continue regular maintenance schedule. Next full inspection recommended in 6 months or 500 charge cycles."
                        android:fontFamily="@font/inter_regular"
                        android:textSize="13sp"
                        android:textColor="#CCCCFF"
                        android:lineSpacingMultiplier="1.5"
                        android:alpha="0.85" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═════════════════════════════════════════ -->
            <!-- ACTION BUTTONS                           -->
            <!-- ═════════════════════════════════════════ -->
            <Button
                android:id="@+id/btnDownloadPdf"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="Download PDF Report"
                android:textSize="15sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/white"
                android:background="@drawable/bg_button_primary"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnShareReport"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="Share Report"
                android:textSize="15sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/brand_blue"
                android:background="@drawable/bg_button_outlined"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnNewTest"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="New Test"
                android:textSize="15sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.6"
                android:background="@null" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
